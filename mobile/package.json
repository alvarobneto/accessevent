{
  "name": "accessevent-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:release": "expo run:android --variant release --device",
    "android:apk": "./android/gradlew -p android assembleRelease && npm run android:apk:copy",
    "android:apk:copy": "mkdir -p dist && cp android/app/build/outputs/apk/release/app-release.apk dist/app-release.apk",
    "android:apk:debug": "./android/gradlew -p android assembleDebug",
    "android:prebuild": "expo prebuild --platform android",
    "android:install": "./android/gradlew -p android installRelease",
    "android:clean": "./android/gradlew -p android clean",
    "android:devices": "adb devices -l",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@typescript-eslint/parser": "^8.71.0",
    "babel-preset-expo": "^57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-dom": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
