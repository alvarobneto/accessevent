# URL base da API REST do backend NestJS.
# Android emulador: use http://10.0.2.2:3333
# Device físico na mesma rede: use http://<IP-DO-COMPUTADOR>:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Timeout das requisições HTTP, em milissegundos.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=10000

# Fonte de dados: api (backend NestJS) | memory (protótipo em memória, sem persistência).
# `memory` reinicia os dados a cada abertura do app; use-a quando a API não estiver no ar.
EXPO_PUBLIC_DATA_SOURCE=api

# Chave da API do Google Maps SDK for Android.
#
# O Google Maps no Android exige `com.google.android.geo.API_KEY` no manifesto, e
# sem a chave o app MORRE ao abrir qualquer tela de mapa. Não dá para contornar:
# o `app.config.ts` injeta a chave no `prebuild` (é onde o manifesto nativo é
# gerado), então trocar a chave exige um build novo.
#
# Onde pegar: Google Cloud → criar projeto → "APIs e serviços" → ativar "Maps SDK
# for Android" → "Credenciais" → "Criar chave de API". Depois restrinja a chave
# por "Aplicativos Android", com o nome do pacote `com.accessevent.app` e o SHA-1
# da assinatura — assim a chave não serve para outro app.
#
# Enquanto o `PLACEHOLDER` estiver aqui, o mapa não é montado no Android e a tela
# mostra "Mapa indisponível" em vez de crashar. No iOS o mapa funciona sem chave
# (Apple Maps), então o placeholder não afeta o iOS.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=PLACEHOLDER
