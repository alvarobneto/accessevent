# Copie para `.env` na raiz antes de usar o docker compose.
# Somente o docker compose lê este arquivo; a API recebe as variáveis via `environment`.

# Porta exposta da API (e valor default de PORT dentro do container).
PORT=3333

# Porta exposta do PostgreSQL.
DATABASE_PORT=5432

# Credenciais usadas pelo container do PostgreSQL.
DATABASE_USERNAME=accessevent
DATABASE_PASSWORD=accessevent
DATABASE_NAME=accessevent

# Origens permitidas no CORS da API. Use * apenas em desenvolvimento.
CORS_ORIGINS=*
